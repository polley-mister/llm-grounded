{
  "name": "llm-grounded",
  "version": "0.1.0",
  "private": false,
  "description": "Deterministic grounding and voice contract for LLM agents. Framework-independent core, with an OpenClaw plugin adapter included.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "default": "./src/core.js"
    },
    "./vectors": "./tests/vectors/grounding-cases.json",
    "./package.json": "./package.json"
  },
  "files": [
    "openclaw.plugin.json",
    "src",
    "types",
    "docs",
    "examples",
    "tests/vectors",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.0",
      "minGatewayVersion": "2026.6.0"
    },
    "build": {
      "openclawVersion": "2026.6.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polley-mister/llm-grounded.git"
  },
  "keywords": [
    "llm",
    "grounding",
    "hallucination",
    "agent",
    "guardrails",
    "evidence",
    "telemetry",
    "openclaw",
    "plugin"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "example": "node examples/minimal.mjs",
    "build:types": "tsc -p tsconfig.json",
    "check:types": "tsc -p tsconfig.json --outDir /tmp/llm-grounded-types-check && diff -r types /tmp/llm-grounded-types-check",
    "prepublishOnly": "npm run build:types && npm test",
    "claims:extract": "node scripts/claims-extract.mjs"
  },
  "types": "./types/index.d.ts",
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}

{
  "name": "llm-grounded",
  "version": "1.11.0",
  "private": false,
  "description": "Deterministic grounding and voice contract for LLM agents. Framework-independent core, with an OpenClaw plugin adapter included.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "openclaw.plugin.json",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.0",
      "minGatewayVersion": "2026.6.0"
    },
    "build": {
      "openclawVersion": "2026.6.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/llm-grounded.git"
  },
  "keywords": [
    "llm",
    "grounding",
    "hallucination",
    "agent",
    "guardrails",
    "evidence",
    "telemetry",
    "openclaw",
    "plugin"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}

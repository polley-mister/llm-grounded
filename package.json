{
  "name": "openclaw-groundskeeper",
  "version": "1.11.0",
  "private": false,
  "description": "Deterministic grounding and voice contract for OpenClaw agents.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "openclaw.plugin.json",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.0",
      "minGatewayVersion": "2026.6.0"
    },
    "build": {
      "openclawVersion": "2026.6.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/openclaw-groundskeeper.git"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "llm",
    "grounding",
    "hallucination",
    "agent",
    "guardrails"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
